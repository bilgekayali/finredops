{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/production-reference-deployment.schema.json",
  "title": "FinRedOps Production Reference Deployment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "profile_id",
    "production_active_testing_allowed",
    "autonomous_target_discovery_allowed",
    "components",
    "deployment_owner_responsibilities"
  ],
  "properties": {
    "schema_version": {"const": "finredops.production-reference-deployment.v1"},
    "release_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "production_active_testing_allowed": {"const": false},
    "autonomous_target_discovery_allowed": {"const": false},
    "deployment_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_identity",
        "tenant_authorization",
        "postgresql_rls",
        "institution_cryptography",
        "configuration_change_control",
        "external_audit_anchor",
        "evidence_vault",
        "isolated_worker"
      ],
      "properties": {
        "external_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "pinned_provider_configuration", "operator_supplied_jwks", "network_discovery"],
          "properties": {
            "protocol": {"const": "oidc_jwks"},
            "pinned_provider_configuration": {"const": true},
            "operator_supplied_jwks": {"const": true},
            "network_discovery": {"const": false}
          }
        },
        "tenant_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_subject_grants", "provider_config_digest_pinned", "capability_allowlist"],
          "properties": {
            "exact_subject_grants": {"const": true},
            "provider_config_digest_pinned": {"const": true},
            "capability_allowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["store_read", "store_write", "audit_verify", "crypto_use"]}
            }
          }
        },
        "postgresql_rls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major_version", "force_rls", "session_user_tenant_source", "runtime_superuser_allowed", "runtime_bypassrls_allowed"],
          "properties": {
            "major_version": {"const": 17},
            "force_rls": {"const": true},
            "session_user_tenant_source": {"const": true},
            "runtime_superuser_allowed": {"const": false},
            "runtime_bypassrls_allowed": {"const": false}
          }
        },
        "institution_cryptography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "required_key_purposes", "key_references_supplied_out_of_band"],
          "properties": {
            "provider": {"const": "aws_kms"},
            "required_key_purposes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"enum": ["data_encryption", "audit_signing", "workload_identity"]}
            },
            "key_references_supplied_out_of_band": {"const": true}
          }
        },
        "configuration_change_control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["independent_governors", "required_roles", "distinct_key_material_required"],
          "properties": {
            "independent_governors": {"const": 2},
            "required_roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["configuration_governor", "security_governor"]}
            },
            "distinct_key_material_required": {"const": true}
          }
        },
        "external_audit_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "separate_trust_root", "independent_administrative_domain_required"],
          "properties": {
            "transport": {"const": "pinned_https"},
            "separate_trust_root": {"const": true},
            "independent_administrative_domain_required": {"const": true}
          }
        },
        "evidence_vault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["envelope_encryption", "append_only_custody", "forward_only_retention", "legal_hold", "physical_worm_storage_external"],
          "properties": {
            "envelope_encryption": {"const": true},
            "append_only_custody": {"const": true},
            "forward_only_retention": {"const": true},
            "legal_hold": {"const": true},
            "physical_worm_storage_external": {"const": true}
          }
        },
        "isolated_worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["non_production_only", "single_use_test_account", "strict_egress_binding", "signed_receipt_required", "emergency_stop_verified"],
          "properties": {
            "non_production_only": {"const": true},
            "single_use_test_account": {"const": true},
            "strict_egress_binding": {"const": true},
            "signed_receipt_required": {"const": true},
            "emergency_stop_verified": {"const": true}
          }
        }
      }
    },
    "deployment_owner_responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 200}
    }
  }
}
