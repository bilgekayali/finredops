{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.dev/schemas/workload-identity-attestation.schema.json",
  "title": "FinRedOps workload identity attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","institution_id","worker_id","deployment_id","isolation_profile","runtime_image_digest","network_policy_digest","isolation_evidence_digest","issued_at","expires_at","key_id","provider","key_ref_digest","signing_algorithm","signature","signing_document_digest","artifact_digest","control_plane_embedded","private_key_embedded"],
  "properties": {
    "schema_version": {"const": "finredops.workload-identity-attestation.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "isolation_profile": {"type": "string", "minLength": 1, "maxLength": 512},
    "runtime_image_digest": {"$ref": "#/$defs/digest"},
    "network_policy_digest": {"$ref": "#/$defs/digest"},
    "isolation_evidence_digest": {"$ref": "#/$defs/digest"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider": {"type": "string", "minLength": 1, "maxLength": 512},
    "key_ref_digest": {"$ref": "#/$defs/digest"},
    "signing_algorithm": {"type": "string", "minLength": 1, "maxLength": 512},
    "signature": {"type": "string", "minLength": 2, "maxLength": 16384, "pattern": "^[A-Za-z0-9_-]+$"},
    "signing_document_digest": {"$ref": "#/$defs/digest"},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "control_plane_embedded": {"const": false},
    "private_key_embedded": {"const": false}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
