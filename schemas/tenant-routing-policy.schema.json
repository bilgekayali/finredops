{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/tenant-routing-policy.schema.json",
  "title": "FinRedOps Tenant Routing Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "institution_id", "oidc_provider_id", "oidc_provider_config_digest", "grants", "policy_digest"],
  "properties": {
    "schema_version": {"const": "finredops.tenant-routing-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "oidc_provider_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "oidc_provider_config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "roles", "capabilities", "status"],
        "properties": {
          "subject": {"type": "string", "minLength": 1, "maxLength": 200},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["qualified_tester", "review_governor", "business_risk_owner", "report_approver"]}
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["store_read", "store_write", "audit_verify", "crypto_use"]}
          },
          "status": {"enum": ["active", "disabled"]}
        }
      }
    },
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
