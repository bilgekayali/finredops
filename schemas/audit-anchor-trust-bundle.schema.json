{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinRedOps Audit Anchor Trust Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "anchor_id", "keys", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "finredops.audit-anchor-trust-bundle.v1"},
    "anchor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "public_key", "not_before", "not_after", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "public_key": {"type": "string", "minLength": 1, "maxLength": 128},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "status": {"enum": ["active", "retiring", "disabled"]}
        }
      }
    },
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
