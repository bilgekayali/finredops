{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/tenant-authorization.schema.json",
  "title": "FinRedOps Tenant Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "institution_id", "institution_context_digest", "policy_id", "policy_digest", "verification_id", "verification_digest", "provider_id", "subject", "roles", "capabilities", "authorized_at", "expires_at", "external_idp_protocol_verified", "tenant_route_authorized", "authorization_digest"],
  "properties": {
    "schema_version": {"const": "finredops.tenant-authorization.v1"},
    "authorization_id": {"type": "string", "pattern": "^FRX-TNA-[A-F0-9]{24}$"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verification_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "verification_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "subject": {"type": "string", "minLength": 1, "maxLength": 200},
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["qualified_tester", "review_governor", "business_risk_owner", "report_approver"]}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["store_read", "store_write", "audit_verify", "crypto_use"]}
    },
    "authorized_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "integer"},
    "external_idp_protocol_verified": {"const": true},
    "tenant_route_authorized": {"const": true},
    "authorization_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
