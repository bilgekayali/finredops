{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/reviewer-trust-bundle.schema.json",
  "title": "FinRedOps Reviewer Trust Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "keys"],
  "properties": {
    "schema_version": {"const": "finredops.reviewer-trust-bundle.v1"},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issuer", "key_id", "algorithm", "public_key", "roles", "not_before", "not_after"],
        "properties": {
          "issuer": {"type": "string", "minLength": 1, "maxLength": 200},
          "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "algorithm": {"const": "Ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["qualified_tester", "review_governor"]}
          },
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
