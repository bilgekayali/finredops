{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","institution_id","engagement_id","evidence_id","sequence","timestamp","actor_id","action","purpose","details","previous_hash","event_hash"],
  "properties": {
    "schema_version": {"const": "finredops.evidence-vault-custody-event.v1"},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "action": {"enum": ["ingested","accessed","exported","legal_hold_applied","legal_hold_released","retention_extended","deletion_approved","restored"]},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "details": {"type": "object"},
    "previous_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
