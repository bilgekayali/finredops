{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record", "custody_events", "exported_at", "exported_by", "purpose", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "finredops.evidence-vault-recovery-bundle.v1"},
    "record": {"type": "object"},
    "custody_events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "exported_at": {"type": "string", "format": "date-time"},
    "exported_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
