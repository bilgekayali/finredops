{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/postgres-service-account-change.schema.json",
  "title": "FinRedOps PostgreSQL Service Account Change v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service_role", "institution_id", "access_mode", "contract_digest", "mapping_digest"],
  "properties": {
    "schema_version": {"const": "finredops.postgres-service-account-change.v1"},
    "service_role": {"type": "string", "minLength": 1, "maxLength": 200},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "access_mode": {"enum": ["read", "write"]},
    "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mapping_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}