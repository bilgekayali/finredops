{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finredops.example/schemas/change-signature.schema.json",
  "title": "FinRedOps Change Signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signature_id", "issuer", "subject", "key_id", "algorithm", "role", "institution_id", "change_id", "request_digest", "issued_at", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": "finredops.change-signature.v1"},
    "signature_id": {"type": "string", "pattern": "^FRX-CHS-[A-F0-9]{24}$"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 200},
    "subject": {"type": "string", "minLength": 1, "maxLength": 200},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "algorithm": {"const": "Ed25519"},
    "role": {"enum": ["configuration_governor", "security_governor"]},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "change_id": {"type": "string", "pattern": "^FRX-CHG-[A-F0-9]{24}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 1}
  }
}