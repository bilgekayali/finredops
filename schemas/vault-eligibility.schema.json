{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institution_id", "engagement_id", "evidence_id", "evaluated_at", "retention_until", "active_hold_ids", "eligible", "reasons", "eligibility_digest"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "institution_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "retention_until": {"type": "string", "format": "date"},
    "active_hold_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "eligible": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "eligibility_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
