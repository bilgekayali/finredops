{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinRedOps ASVS Requirement Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_version", "source_sha256", "source_ref", "requirement_refs", "standard_name", "requirement_text_embedded", "catalog_digest"],
  "properties": {
    "schema_version": {"const": "finredops.asvs-requirement-catalog.v1"},
    "source_version": {"const": "5.0.0"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
    "requirement_refs": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "pattern": "^v5\\.0\\.0-[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$"}},
    "standard_name": {"const": "OWASP ASVS"},
    "requirement_text_embedded": {"const": false},
    "catalog_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
